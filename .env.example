# Never commit real credentials. Rotate any credentials that appeared in chat exports.
WG_GESUCHT_EMAIL=
WG_GESUCHT_PASSWORD=
WG_SESSION_FILE=.data/wg_session.json

# App security. Use long random values in production.
APP_SECRET_KEY=change-me
DATABASE_PATH=.data/wg_review.sqlite3
APP_BASE_URL=http://127.0.0.1:8000

# Google OAuth web application
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/api/calendar/google/callback

# Microsoft Entra app registration (personal + work/school accounts)
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=http://127.0.0.1:8000/api/calendar/microsoft/callback
